[Unit]
Description=Genova Emergency verified backup and retention
After=genova-emergency.service

[Service]
Type=oneshot
User=genova-emergency
Group=genova-emergency
WorkingDirectory=/opt/genova-emergency
EnvironmentFile=/etc/genova-emergency/emergency.env
ExecStart=/opt/genova-emergency/.venv/bin/python /opt/genova-emergency/scripts/snapshot.py backup
ExecStart=/opt/genova-emergency/.venv/bin/python /opt/genova-emergency/scripts/snapshot.py prune
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/genova-emergency/data
