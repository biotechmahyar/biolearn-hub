# Copy to /etc/genova-emergency/emergency.env and set mode 0600.
# Never store real secrets in this repository.
EMERGENCY_ENV=production
EMERGENCY_HOST=127.0.0.1
EMERGENCY_PORT=8000
EMERGENCY_DATABASE_PATH=/opt/genova-emergency/data/emergency.sqlite3
EMERGENCY_ARTIFACT_ROOT=/opt/genova-emergency/data/snapshots
EMERGENCY_BACKUP_ROOT=/opt/genova-emergency/data/backups
EMERGENCY_FILE_ROOT=/opt/genova-emergency/data/files
EMERGENCY_TRUSTED_HOSTS=127.0.0.1,localhost,emergency.example.com
EMERGENCY_CORS_ORIGINS=https://emergency.example.com
EMERGENCY_DOCS_ENABLED=false
EMERGENCY_REQUEST_TELEMETRY_ENABLED=true
EMERGENCY_TELEMETRY_RETENTION_DAYS=30
EMERGENCY_ARTIFACT_RETENTION_DAYS=30
EMERGENCY_ARTIFACT_RETENTION_KEEP=14
EMERGENCY_BACKUP_RETENTION_DAYS=30
EMERGENCY_AUTH_RATE_LIMIT_ATTEMPTS=5
EMERGENCY_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
EMERGENCY_AUTH_RATE_LIMIT_BLOCK_SECONDS=900
EMERGENCY_MAX_REQUEST_BODY_BYTES=2097152
EMERGENCY_MAX_FILE_BYTES=104857600
